   <Row><Cell><Data ss:Type="String">Item</Data></Cell><Cell><Data ss:Type="String">Description</Data></Cell><Cell><Data ss:Type="String">Amount</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">BHCK2170</Data></Cell><Cell><Data ss:Type="String">Total assets</Data></Cell><Cell><Data ss:Type="Number">1250</Data></Cell><Cell><Data ss:Type="DateTime">2027-03-31T00:00:00.000</Data></Cell></Row>
